# Fingerprint SaaS - Environment Configuration

# Database
DATABASE_URL=postgres://fp:fp@localhost:5432/fingerprint

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (empty = allow all)
ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# IPinfo token for IP geolocation + VPN/proxy detection (free: 50k/month)
# Get one at https://ipinfo.io/signup — enables accurate geo + privacy lookup.
# Without it: geo = unknown, VPN detection falls back to bundled datacenter list.
IPINFO_TOKEN=

# Dashboard login (CHANGE in production!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
